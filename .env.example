# PublicHealthSentinel - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment:
#   Copy-Item .env.example .env

# --- Application Core ---
APP_NAME=PublicHealthSentinel
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# --- Filesystem Paths ---
DATA_DIR=data
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic
DATA_DOCUMENTS_DIR=data/documents
MAX_DOCUMENT_SIZE_BYTES=5242880

# --- Future Phases Placeholders (Do NOT add real credentials here) ---

# --- Phase 5: Database Connection ---
# SQLite default for local development and testing:
DATABASE_URL=sqlite:///./data/public_health_sentinel.db
DB_ECHO=false

# PostgreSQL configuration (uncomment for production/hosted database):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=public_health_sentinel
# DB_USER=sentinel_user
# DB_PASSWORD=sentinel_placeholder_password
# DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_placeholder_password@localhost:5432/public_health_sentinel

# --- Phase 5: FastAPI Service Settings ---
API_HOST=127.0.0.1
API_PORT=8000
API_TITLE=PublicHealthSentinel API
API_VERSION=v1

# --- Phase 6: Evidence & Assistant Configuration ---
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
GENERATION_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=90.0

# --- Phase 10: Free Cloud Demo Mode (Render Free Tier 512MB RAM) ---
# Set to true to bypass heavyweight PyTorch/Ollama and enable self-seeding SQLite:
DEMO_MODE=false
# CORS regex pattern for cloud deployment (e.g., Render domains):
# CORS_ORIGIN_REGEX=^https://.*\.onrender\.com$
# Frontend API Base URL (empty for local Vite proxy, set for static hosting):
# VITE_API_BASE_URL=https://public-health-sentinel-api.onrender.com
